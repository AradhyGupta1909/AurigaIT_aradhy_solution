<body class="auth-page"><main class="auth-card"><a class="back-link" href="/">Daily Tiffin</a><p class="eyebrow">Customer account</p><h1>Log in</h1><form class="stack-form" method="post" action="/customer/login"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" required><label for="password">Password</label><input id="password" name="password" type="password" required><button class="button" type="submit">Log in</button></form><p class="form-footer">New customer? <a href="/customer/register">Create an account</a></p></main></body></html>