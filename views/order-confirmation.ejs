<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Order confirmed | Daily Tiffin</title><link rel="stylesheet" href="/styles.css"></head>
<body class="app-page"><%- include('partials/customer-nav') %><main class="page-content narrow-content"><p class="eyebrow">Order confirmed</p><h1>Lunch is on its way.</h1><p class="intro">This order is covered under your existing monthly plan. There is no separate charge.</p><section class="confirmation-box"><p><strong>Delivery agent</strong><br><%= order.agent_name %> · <%= order.agent_phone %></p><p><strong>Estimated delivery</strong><br><%= new Date(order.estimated_delivery_time).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) %></p><p><strong>Items</strong><br><%= order.items.map((item) => `${item.name} × ${item.quantity}`).join(', ') %></p></section><a class="button" href="/customer/orders">View my orders</a></main><script src="/owner.js"></script></body></html>