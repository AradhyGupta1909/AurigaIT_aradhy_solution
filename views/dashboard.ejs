<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard | Daily Tiffin</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-page">
  <%- include('partials/nav', { context: 'owner' }) %>
  <main class="page-content">
    <div class="page-heading"><div><p class="eyebrow">Owner workspace</p><h1>Customers</h1></div><a class="button" href="/customers/new">Add customer</a></div>
    <section class="toolbar" aria-label="Customer filters">
      <form id="customer-filters" class="filter-form">
        <label class="sr-only" for="search">Search name or phone</label>
        <input id="search" name="search" type="search" placeholder="Search name or phone">
        <label class="sr-only" for="status">Filter by status</label>
        <select id="status" name="status">
          <option value="">All statuses</option>
          <option value="active">Active</option>
          <option value="paused">Paused</option>
          <option value="cancelled">Cancelled</option>
          <option value="none">No subscription</option>
        </select>
        <button class="button" type="submit">Search</button>
      </form>
      <p id="table-message" class="form-message" aria-live="polite"></p>
    </section>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th><button class="sort-button" data-sort="name">Name <span></span></button></th>
          <th><button class="sort-button" data-sort="phone">Phone <span></span></button></th>
          <th><button class="sort-button" data-sort="status">Status <span></span></button></th>
          <th><button class="sort-button" data-sort="created_at">Joined <span></span></button></th>
          <th>Actions</th>
        </tr></thead>
        <tbody id="customer-rows"><tr><td colspan="5">Loading customers...</td></tr></tbody>
      </table>
    </div>
    <div class="pagination"><button id="previous-page" class="button secondary">Previous</button><span id="page-summary"></span><button id="next-page" class="button secondary">Next</button></div>
    <section class="today-orders">
      <div class="section-heading"><p class="eyebrow">Delivery run</p><h2>Today's Orders</h2></div>
      <div class="table-wrap"><table><thead><tr><th>Customer</th><th>Phone</th><th>Items</th><th>Order time</th><th>Agent</th></tr></thead><tbody>
        <% todayOrders.forEach((order) => { %><tr><td><%= order.customer_name %></td><td><%= order.customer_phone %></td><td><%= order.items.map((item) => `${item.name} × ${item.quantity}`).join(', ') %></td><td><%= new Date(order.created_at).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) %></td><td><%= order.agent_name %> · <%= order.agent_phone %></td></tr><% }); %>
        <% if (!todayOrders.length) { %><tr><td colspan="5">No orders for today.</td></tr><% } %>
      </tbody></table></div>
    </section>
  </main>
  <script src="/owner.js"></script>
  <script src="/dashboard.js"></script>
</body>
</html>
