<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Register | Daily Tiffin</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="auth-page">
  <main class="auth-card">
    <a class="back-link" href="/">Daily Tiffin</a>
    <p class="eyebrow">Start your plan</p>
    <h1>Create account</h1>
    <form data-auth-form="register" action="/api/auth/register" method="post">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required>
      <button class="button" type="submit">Register</button>
      <p class="form-message" aria-live="polite"></p>
    </form>
    <p class="form-footer">Already registered? <a href="/login">Log in</a></p>
  </main>
  <script src="/auth.js"></script>
</body>
</html>
