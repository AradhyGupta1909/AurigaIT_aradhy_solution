<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Menu | Daily Tiffin</title><link rel="stylesheet" href="/styles.css"></head>
<body class="app-page"><%- include('partials/nav', { context: 'owner' }) %><main class="page-content"><div class="page-heading"><div><p class="eyebrow">Owner workspace</p><h1>Menu</h1></div></div><form class="toolbar filter-form" method="post" action="/api/menu"><input name="name" placeholder="Item name" required><input name="price" type="number" min="0" placeholder="Price" required><input name="description" placeholder="Description"><button class="button" type="submit">Add item</button></form><div class="table-wrap"><table><thead><tr><th>Name</th><th>Price</th><th>Description</th><th>Available today</th><th>Actions</th></tr></thead><tbody><% menu.forEach((item) => { %><tr><td colspan="4"><form class="menu-edit-form" method="post" action="/api/menu/<%= item.id %>"><input name="name" value="<%= item.name %>" required><input name="price" type="number" min="0" value="<%= item.price %>" required><input name="description" value="<%= item.description %>"><button class="small-button" type="submit">Save</button></form></td><td><form method="post" action="/api/menu/<%= item.id %>/toggle-available"><button class="small-button" type="submit"><%= item.available_today ? 'Hide' : 'Show' %></button></form><span class="muted"><%= item.available_today ? 'Available' : 'Hidden' %></span></td></tr><% }); %></tbody></table></div></main></body></html>