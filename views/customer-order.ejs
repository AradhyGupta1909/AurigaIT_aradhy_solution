<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Today's menu | Daily Tiffin</title><link rel="stylesheet" href="/styles.css"></head>
<body class="app-page"><%- include('partials/customer-nav') %><main class="page-content narrow-content"><p class="eyebrow">Today's menu · <%= date %></p><h1>Choose lunch</h1><% if (!subscription) { %><p class="form-message">Your subscription is paused or unavailable today. Check back when delivery is active.</p><% } else { %><p class="intro">Your order is covered under your existing monthly plan. No separate charge.</p><form id="customer-order-form" class="stack-form" method="post" action="/customer/order"><% menu.forEach((item) => { %><label class="menu-choice"><input type="checkbox" data-menu-id="<%= item.id %>"><span><strong><%= item.name %></strong><small><%= item.description %> · &#8377;<%= item.price.toFixed(2) %></small></span><input class="quantity-input" data-quantity type="number" min="1" value="1"></label><% }); %><button class="button" type="submit">Place order</button><p id="order-message" class="form-message" aria-live="polite"></p></form><% } %></main><script src="/owner.js"></script><script src="/customer-order.js"></script></body></html>