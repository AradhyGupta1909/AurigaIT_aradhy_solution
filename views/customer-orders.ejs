<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My orders | Daily Tiffin</title><link rel="stylesheet" href="/styles.css"></head>
<body class="app-page"><%- include('partials/customer-nav') %><main class="page-content"><p class="eyebrow">Customer account</p><h1>My orders</h1><div class="table-wrap"><table><thead><tr><th>Date</th><th>Items</th><th>Status</th><th>Agent</th><th>ETA</th></tr></thead><tbody><% orders.forEach((order) => { %><tr><td><%= order.order_date %></td><td><%= order.items.map((item) => `${item.name} × ${item.quantity}`).join(', ') %></td><td><%= order.status %></td><td><%= order.agent_name %></td><td><%= new Date(order.estimated_delivery_time).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) %></td></tr><% }); %><% if (!orders.length) { %><tr><td colspan="5">No orders yet.</td></tr><% } %></tbody></table></div></main><script src="/owner.js"></script></body></html>